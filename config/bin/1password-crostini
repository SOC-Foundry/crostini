#!/usr/bin/env bash
# crostini · CHG-012 — visible 1Password UI on Crostini (no DRM/GPU)
set -euo pipefail
BIN=""
for cand in /usr/bin/1password /opt/1Password/1password; do
  if [[ -x "$cand" ]]; then
    BIN="$cand"
    break
  fi
done
[ -n "$BIN" ] || { echo "missing 1password binary" >&2; exit 1; }
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-x11}"
unset WAYLAND_DISPLAY 2>/dev/null || true
exec "$BIN" \
  --ozone-platform=x11 \
  --disable-gpu \
  --disable-gpu-compositing \
  --disable-dev-shm-usage \
  --no-sandbox \
  "$@"
