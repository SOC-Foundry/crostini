[Desktop Entry]
Name=Chromium
Comment=Personal Linux browser, 2 tabs max (Crostini). Not Island.
Exec=/usr/local/bin/chromium-crostini %U
TryExec=/usr/local/bin/chromium-crostini
Icon=chromium
Type=Application
Terminal=false
StartupNotify=true
StartupWMClass=chromium
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/local/bin/chromium-crostini

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/usr/local/bin/chromium-crostini --incognito
