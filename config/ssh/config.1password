# crostini · CHG-012 — personal GitHub only. Do not use Host *.
# IdentityFile is the public key so OpenSSH selects the agent identity
# without needing the private file on disk.
Host github.com ssh.github.com
  IdentityAgent ~/.1password/agent.sock
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes
